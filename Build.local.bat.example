@echo off
:: OPTIONAL. Copy to Build.local.bat (gitignored) only if you want Build.bat options [1]/[2] with your own Launch4j configs.
:: Everyone else can just run Build.bat and choose [4] Portable build - no setup needed.
:: INSTALL_DIR is only used for the "launch after build" prompt.

:: set "WORKSPACE=C:\path\to\this\repo"
set "INSTALL_DIR=C:\path\to\your\install folder"
set "LAUNCH4J=C:\path\to\launch4j\launch4jc.exe"
set "CONFIG_RELEASE=C:\path\to\launch4j\config.xml"
set "CONFIG_TEST=C:\path\to\launch4j\configTest.xml"
